<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Preserve real files and directories such as compiled assets and images.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Let React Router handle direct access and refreshes on application routes.
  RewriteRule ^ index.html [L]
</IfModule>
